# Public client configuration from Supabase Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Enable only after deploying `continuum-provider` and setting its server-side
# secrets. Third-party provider keys must never use an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SECURE_PROVIDER_PROXY=false

# Keep true for the seeded hackathon demo. Set false to require email/password
# authentication plus a patient access invite code.
EXPO_PUBLIC_DEMO_MODE=true

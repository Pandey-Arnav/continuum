# Required — from your Supabase project (Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — leave unset to use mock providers (app runs fully offline/free).
# Each is wired up independently: set only the ones you have.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
